# Docker public-data sandbox only. Choose an alphanumeric password.
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_value
FRAUDSHIELD_PUBLIC_URL=http://localhost:8000
FRAUDSHIELD_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FRAUDSHIELD_SECURE_COOKIES=0
# Use HTTPS and secure cookies behind your reverse proxy for external hosting.
# Stripe test keys only. Leave blank to keep checkout disabled.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
